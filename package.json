{
  "name": "bayer-bilinear-backend",
  "version": "1.0.0",
  "description": "Windows 本地 Bayer 马赛克双线性重建 API 与 CLI",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "bayer-cli": "dist/cli/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/cli/index.js serve",
    "demo": "npm run build && node dist/cli/index.js demo"
  },
  "keywords": [
    "bayer",
    "demosaic",
    "typescript",
    "sqlite"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.9.0"
  }
}
